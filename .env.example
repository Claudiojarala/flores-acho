# Copia este archivo a .env.local y completa los valores (NO subir .env.local)

# Secreto para firmar los JWT (HMAC-SHA256). Mínimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opcional: si está definido se usa PostgreSQL (Supabase); si no, repositorio en memoria (demo)
# Usa la cadena de conexión "Transaction pooler" de Supabase.
DATABASE_URL=
